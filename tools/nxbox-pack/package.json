{
  "name": "nxbhelper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests package.json tsconfig.json README.md",
    "build": "bun build src/cli.ts --compile --outfile dist/nxbhelper",
    "build:windows": "bun scripts/build-windows.ts",
    "build:macos": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --outfile dist/nxbhelper-macos-arm64",
    "build:linux": "bun build src/cli.ts --compile --target=bun-linux-x64-baseline --outfile dist/nxbhelper-linux-x64"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "prettier": "3.8.1"
  },
  "license": "GPL-3.0-or-later"
}
