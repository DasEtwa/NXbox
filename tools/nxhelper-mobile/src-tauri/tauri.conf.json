{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NxbHelper",
  "version": "0.1.0",
  "identifier": "com.nxhelper.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NxbHelper",
        "width": 420,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright 2026 NSPX",
    "iOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
