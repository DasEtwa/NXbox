<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="NSPX.NXbox" Publisher="CN=NXbox" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>NXbox</DisplayName>
    <PublisherDisplayName>NSPX</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30704.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="nxbox.exe" EntryPoint="NXbox.App">
      <uap:VisualElements DisplayName="NXbox" Description="NXbox"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
      <Extensions>
        <!-- nxbox://play?title=<16 hex digits> boots that library game; the per-game dashboard
             tiles (tools/nxbox/package_launcher.py) open it. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="nxbox">
            <uap:DisplayName>NXbox</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Removable storage filters files by the associations declared here: a type missing
             from this list is invisible on a USB drive. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="nxboxfirmware">
            <uap:SupportedFileTypes>
              <uap:FileType>.nca</uap:FileType>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.bin</uap:FileType>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
