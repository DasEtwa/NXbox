        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="nxboxgames">
            <uap:SupportedFileTypes>
              <uap:FileType>.nsp</uap:FileType>
              <uap:FileType>.nsz</uap:FileType>
              <uap:FileType>.xci</uap:FileType>
              <uap:FileType>.xcz</uap:FileType>
              <!-- Atomic FTP uploads, downloads and game moves stage files beside the target. -->
              <uap:FileType>.part</uap:FileType>
              <uap:FileType>.partial</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="nxboxkeys">
            <uap:SupportedFileTypes>
              <uap:FileType>.keys</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="codeGeneration" />
    <!-- Reads game/key files from a USB drive (KnownFolders.RemovableDevices), so a player can set
         up NXbox without a PC and the Device Portal. -->
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
